{
    "name": "voiceassist",
    "version": "0.1.0",
    "description": "Voice dictation and read-aloud desktop app",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && svelte-check --tsconfig tsconfig.web.json",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "lint": "eslint src",
        "format": "prettier --write src",
        "package:mac": "pkill -f VoiceAssist; hdiutil detach \"/Volumes/VoiceAssist 0.1.0-arm64\" -force 2>/dev/null; npm run build && electron-builder --mac",
        "package:win": "npm run build && electron-builder --win",
        "download:whisper": "node scripts/download-whisper.js",
        "download:whisper-small": "node scripts/download-whisper.js small.en",
        "download:whisper-all": "node scripts/download-whisper.js all",
        "download:piper": "node scripts/download-piper.js",
        "download:all": "node scripts/download-whisper.js && node scripts/download-piper.js"
    },
    "build": {
        "appId": "com.voiceassist.app",
        "productName": "VoiceAssist",
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "resources/models/",
                "to": "models",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "resources/voices/",
                "to": "voices",
                "filter": [
                    "**/*",
                    "!en_US-kathleen-medium.onnx"
                ]
            },
            {
                "from": "src/main/dictionaries/",
                "to": "dictionaries",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg"
            ],
            "extraResources": [
                {
                    "from": "resources/bin/",
                    "to": "bin",
                    "filter": [
                        "**/*"
                    ]
                },
                {
                    "from": "resources/lib/",
                    "to": "lib",
                    "filter": [
                        "**/*"
                    ]
                }
            ],
            "extendInfo": {
                "NSMicrophoneUsageDescription": "VoiceAssist needs microphone access for dictation.",
                "NSAppleEventsUsageDescription": "VoiceAssist needs automation access to paste text into your apps."
            },
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "extraResources": [
                {
                    "from": "resources/bin-win/",
                    "to": "bin",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "VoiceAssist"
        }
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^4.0.4",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^25.6.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "@vitest/ui": "^4.1.4",
        "electron": "^41.2.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "eslint": "^10.2.1",
        "eslint-plugin-svelte": "^3.17.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "svelte": "^5.55.4",
        "svelte-check": "^4.4.6",
        "terser": "^5.46.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "electron-log": "^5.4.3"
    }
}
