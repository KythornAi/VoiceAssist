{
    "name": "voiceassist",
    "version": "0.1.0",
    "description": "Voice dictation and read-aloud desktop app",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "package:mac": "npm run build && electron-builder --mac",
        "package:win": "npm run build && electron-builder --win",
        "download:whisper": "node scripts/download-whisper.js",
        "download:whisper-small": "node scripts/download-whisper.js small.en",
        "download:whisper-all": "node scripts/download-whisper.js all",
        "download:piper": "node scripts/download-piper.js",
        "download:all": "node scripts/download-whisper.js && node scripts/download-piper.js"
    },
    "build": {
        "appId": "com.voiceassist.app",
        "productName": "VoiceAssist",
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "resources/models/",
                "to": "models",
                "filter": ["**/*"]
            },
            {
                "from": "resources/voices/",
                "to": "voices",
                "filter": ["**/*", "!en_US-kathleen-medium.onnx"]
            },
            {
                "from": "src/main/dictionaries/",
                "to": "dictionaries",
                "filter": ["**/*"]
            }
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg"
            ],
            "extraResources": [
                {
                    "from": "resources/bin/",
                    "to": "bin",
                    "filter": ["**/*"]
                }
            ],
            "extendInfo": {
                "NSMicrophoneUsageDescription": "VoiceAssist needs microphone access for dictation.",
                "NSAppleEventsUsageDescription": "VoiceAssist needs automation access to paste text into your apps."
            },
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "win": {
            "target": [
                "nsis"
            ],
            "extraResources": [
                {
                    "from": "resources/bin-win/",
                    "to": "bin",
                    "filter": ["**/*"]
                }
            ]
        }
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "terser": "^5.46.0"
    },
    "dependencies": {}
}