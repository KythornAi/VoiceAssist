{
    "name": "voiceassist",
    "version": "0.1.0",
    "description": "Voice dictation and read-aloud desktop app",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "package:mac": "npm run build && electron-builder --mac",
        "package:win": "npm run build && electron-builder --win",
        "download:whisper": "node scripts/download-whisper.js"
    },
    "build": {
        "appId": "com.voiceassist.app",
        "productName": "VoiceAssist",
        "directories": {
            "output": "dist"
        },
        "extraFiles": [
            {
                "from": "resources/bin/",
                "to": "bin",
                "filter": ["**/*"]
            },
            {
                "from": "resources/models/",
                "to": "models",
                "filter": ["**/*"]
            }
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg"
            ],
            "extendInfo": {
                "NSMicrophoneUsageDescription": "VoiceAssist needs microphone access for dictation.",
                "NSCameraUsageDescription": "VoiceAssist needs camera access for reading features."
            },
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "win": {
            "target": [
                "nsis"
            ]
        }
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "terser": "^5.46.0"
    },
    "dependencies": {}
}