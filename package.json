{
    "name": "voiceassist",
    "version": "0.1.0",
    "description": "Voice dictation and read-aloud desktop app",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && cp node_modules/@xenova/transformers/dist/*.wasm out/renderer/",
        "package:mac": "npm run build && electron-builder --mac",
        "package:win": "npm run build && electron-builder --win"
    },
    "build": {
        "appId": "com.voiceassist.app",
        "productName": "VoiceAssist",
        "directories": {
            "output": "dist"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg"
            ],
            "extendInfo": {
                "NSMicrophoneUsageDescription": "VoiceAssist needs microphone access for dictation.",
                "NSCameraUsageDescription": "VoiceAssist needs camera access for reading features."
            },
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "asarUnpack": [
                "**/*.wasm",
                "**/node_modules/@xenova/transformers/**/*"
            ]
        },
        "win": {
            "target": [
                "nsis"
            ],
            "asarUnpack": [
                "**/*.wasm"
            ]
        }
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "terser": "^5.46.0",
        "vite-plugin-static-copy": "^3.2.0"
    },
    "dependencies": {
        "@xenova/transformers": "^2.17.2"
    }
}